{
  "name": "dats-archival",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/copy-cesium.mjs && next dev",
    "build": "node scripts/copy-cesium.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "test:geometry": "node --import ./scripts/register-test-hooks.mjs --test --experimental-strip-types \"src/features/dome-monitor/lib/__tests__/*.test.ts\"",
    "test": "npm run test:geometry",
    "validate:geometry": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-test-hooks.mjs --experimental-strip-types scripts/validate-dome-geometry.ts",
    "copy:cesium": "node scripts/copy-cesium.mjs",
    "postinstall": "node scripts/copy-cesium.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "cesium": "^1.144.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.33.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resium": "^1.25.0",
    "three": "^0.184.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
